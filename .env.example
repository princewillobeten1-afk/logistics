# Copy to .env and fill in. .env is gitignored — never commit a real key.

DATABASE_URL=postgresql://logistics:logistics@localhost:5433/logistics

# NVIDIA NIM. Get a key at https://build.nvidia.com
# NOTE: the hosted tier is licensed for development, testing, research and
# evaluation only. Production requires NVIDIA AI Enterprise, or self-hosting
# Nemotron on vLLM — in which case only NVIDIA_BASE_URL changes.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA cuOpt Route Optimization (defaults to NVIDIA_API_KEY if NVIDIA_CUOPT_API_KEY is unset)
NVIDIA_CUOPT_URL=https://optimize.api.nvidia.com/v1/nvidia/cuopt
NVIDIA_CUOPT_STATUS_URL=https://optimize.api.nvidia.com/v1/status
NVIDIA_CUOPT_API_KEY=

# Sit under the hosted ~40 RPM ceiling. Bursts, not averages, trip it.
LLM_MAX_RPM=30
LLM_MAX_CONCURRENCY=4
LLM_MAX_ATTEMPTS=3

WORKER_CONCURRENCY=4
# Must exceed the slowest handler or a live worker's item gets reclaimed.
WORKER_LEASE_S=300

LOG_LEVEL=INFO
LOG_JSON=false

# WordPress WPCargo Portal (used by the Customer Support Agent to register
# customer shipments before handing off to the Orchestrator pipeline)
WPCARGO_URL=https://test.swiftparcelcourier.com
WPCARGO_USERNAME=
WPCARGO_PASSWORD=
